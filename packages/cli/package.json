{
  "name": "@pixel-forge/cli",
  "version": "0.1.0",
  "description": "The pf binary: serve, mcp, check, convert, render, export, lint, override import, pack/unpack.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "pf": "./bundle/pf.mjs"
  },
  "files": [
    "dist",
    "bundle"
  ],
  "scripts": {
    "build": "tsc -b && tsup",
    "bundle": "tsup",
    "test": "vitest run --root ../.. --project cli"
  },
  "dependencies": {
    "@pixel-forge/ops": "workspace:*",
    "@pixel-forge/server": "workspace:*",
    "commander": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "execa": "^10.2.1",
    "tsup": "^9.0.0"
  }
}
