  {
    "name": "rig_apply_template",
    "title": "rig.applyTemplate",
    "description": "Apply a humanoid skeleton template: bones matched by name are reused, missing ones are created.\n\nTemplates: humanoid-side (view \"side\"), humanoid-front (\"front\"), humanoid-back (\"back\"). With no view a new view is created (named after the template, or viewName); with view the rest pose is set in that view. Creates the rig when the document has none. The template origin is the document origin. Bones that exist with another parent are refused.\n\nChanges the document as one undo step. Conventions: origin top-left, y down, angles in degrees clockwise, integer pixels.\n\nExample (Set the rest pose of the hero in its existing side view): {\"doc\":\"doc_g1ed5q\",\"template\":\"humanoid-side\",\"view\":\"side\"}",
    "inputSchema": {
      "type": "object",
      "properties": {
        "doc": {
          "type": "string",
          "pattern": "^doc_[0-9a-z]{1,24}$",
          "description": "Document id returned by doc_open or doc_create, e.g. \"doc_g1ed5q\"."
        },
        "template": {
          "type": "string",
          "enum": ["humanoid-side", "humanoid-front", "humanoid-back"],
          "description": "Skeleton template: humanoid-side, humanoid-front or humanoid-back."
        },
        "height": {
          "description": "Character height in px, feet row to top of head (default 48).",
          "type": "integer",
          "minimum": 8,
          "maximum": 1024
        },
        "view": {
          "description": "Existing view to set the rest pose in (default: a new view).",
          "type": "string",
          "minLength": 1
        },
        "viewName": {
          "description": "Name of the new view (default: the template name, e.g. \"side\"); ignored with view.",
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["doc", "template"],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "viewId": {
          "type": "string",
          "description": "Id of the view the template was applied to."
        },
        "bones": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          },
          "description": "Bone id per template bone name (reused and created)."
        },
        "created": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Names of the bones that were created."
        }
      },
      "required": ["viewId", "bones", "created"],
      "additionalProperties": false
    },
    "annotations": {
      "title": "rig.applyTemplate",
      "readOnlyHint": false,
      "destructiveHint": false,
      "openWorldHint": false
    },
    "_meta": {
      "pixel-forge/op": "rig.applyTemplate",
      "pixel-forge/safety": "mutate"
    }
  },
  {
    "name": "rig_joint_check",
    "title": "rig.jointCheck",
    "description": "Sweep each joint of one rig view and report the pixel gaps that open on the outer side of a bend.\n\nRead-only. A rig passes when summary.gapCount is 0. The sweep uses the default range and step. Fix gaps by adjusting the part pivots or overrides, then check again. Checks the view that draws the first direction of the given view (default: the first view).\n\nRead-only. Conventions: origin top-left, y down, angles in degrees clockwise, integer pixels.\n\nExample (Check the first view of the hero): {\"doc\":\"doc_g1ed5q\"}",
    "inputSchema": {
      "type": "object",
      "properties": {
        "doc": {
          "type": "string",
          "pattern": "^doc_[0-9a-z]{1,24}$",
          "description": "Document id returned by doc_open or doc_create, e.g. \"doc_g1ed5q\"."
        },
        "view": {
          "description": "Rig view to check (default: the first view).",
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["doc"],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "view": {
          "type": "string",
          "description": "Name of the checked view."
        },
        "params": {
          "type": "object",
          "properties": {
            "rangeDeg": {
              "type": "number",
              "description": "Sweep range, degrees either side of rest."
            },
            "stepDeg": {
              "type": "number",
              "description": "Sweep step, degrees."
            },
            "radius": {
              "type": "integer",
              "description": "Window radius of the check, px."
            }
          },
          "required": ["rangeDeg", "stepDeg", "radius"],
          "additionalProperties": false
        },
        "joints": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "bone": {
                "type": "string",
                "description": "Child bone name."
              },
              "parent": {
                "type": "string",
                "description": "Parent bone name."
              },
              "pivot": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "integer"
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2,
                "description": "Joint pivot, canvas coordinates."
              },
              "gapCount": {
                "type": "integer",
                "description": "Gap pixels summed over the sweep."
              },
              "union": {
                "type": "array",
                "items": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "integer"
                    },
                    {
                      "type": "integer"
                    }
                  ],
                  "items": false,
                  "minItems": 2,
                  "maxItems": 2,
                  "description": "A pixel [x, y], canvas coordinates."
                },
                "description": "Distinct gap pixels over the sweep, sorted by y then x."
              },
              "angles": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "angle": {
                      "type": "number",
                      "description": "Swept angle, degrees clockwise."
                    },
                    "gaps": {
                      "type": "array",
                      "items": {
                        "type": "array",
                        "prefixItems": [
                          {
                            "type": "integer"
                          },
                          {
                            "type": "integer"
                          }
                        ],
                        "items": false,
                        "minItems": 2,
                        "maxItems": 2,
                        "description": "A pixel [x, y], canvas coordinates."
                      },
                      "description": "Gap pixels at this angle."
                    }
                  },
                  "required": ["angle", "gaps"],
                  "additionalProperties": false
                },
                "description": "Every checked angle, ascending."
              }
            },
            "required": ["bone", "parent", "pivot", "gapCount", "union", "angles"],
            "additionalProperties": false
          },
          "description": "One entry per joint, sorted by bone name."
        },
        "summary": {
          "type": "object",
          "properties": {
            "joints": {
              "type": "integer"
            },
            "jointsWithGaps": {
              "type": "integer"
            },
            "gapCount": {
              "type": "integer",
              "description": "0 when the rig passes."
            },
            "unionCount": {
              "type": "integer"
            }
          },
          "required": ["joints", "jointsWithGaps", "gapCount", "unionCount"],
          "additionalProperties": false
        }
      },
      "required": ["view", "params", "joints", "summary"],
      "additionalProperties": false
    },
    "annotations": {
      "title": "rig.jointCheck",
      "readOnlyHint": true,
      "destructiveHint": false,
      "openWorldHint": false
    },
    "_meta": {
      "pixel-forge/op": "rig.jointCheck",
      "pixel-forge/safety": "read"
    }
  },
  {
    "name": "rig_set_pose",
    "title": "rig.setPose",
    "description": "Set bone keys (angle deg clockwise, offset int px) and/or part keys (variant, z, visible) on one frame.\n\nKeys are sparse and merge: the channels you pass replace the stored ones, the others stay; null removes the whole key of that bone or part on this frame. Angles are relative to the rest pose and compose down the hierarchy. Mirror animations have no frames: pose their source. Check the result with render_frame and rig_joint_check.\n\nChanges the document as one undo step. Conventions: origin top-left, y down, angles in degrees clockwise, integer pixels.\n\nExample (Raise the right arm and bend the elbow on frame 0): {\"doc\":\"doc_g1ed5q\",\"animation\":{\"group\":\"default\"},\"frame\":0,\"bones\":{\"upper_arm_r\":{\"angle\":-45},\"lower_arm_r\":{\"angle\":-30}}}",
    "inputSchema": {
      "type": "object",
      "properties": {
        "doc": {
          "type": "string",
          "pattern": "^doc_[0-9a-z]{1,24}$",
          "description": "Document id returned by doc_open or doc_create, e.g. \"doc_g1ed5q\"."
        },
        "animation": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "group": {
                  "type": "string",
                  "pattern": "^[a-z0-9_-]{1,48}$"
                },
                "direction": {
                  "type": "string",
                  "pattern": "^[a-z0-9_-]{1,48}$"
                }
              },
              "required": ["group"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^anm_[0-9a-z]{1,24}$"
                }
              },
              "required": ["id"],
              "additionalProperties": false
            }
          ],
          "description": "Animation: {\"group\": \"run\", \"direction\": \"side\"} ({\"group\": \"idle\"} for an undirected one) or {\"id\": \"anm_...\"}."
        },
        "frame": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "string",
              "pattern": "^frm_[0-9a-z]{1,24}$"
            }
          ],
          "description": "Frame: 0-based index or frame id (\"frm_...\")."
        },
        "bones": {
          "description": "Bone keys by bone name (or id); null removes the key.",
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "angle": {
                    "description": "Rotation from the rest angle, degrees clockwise (child bones follow, FK).",
                    "type": "number"
                  },
                  "offset": {
                    "description": "Pivot translation from its rest position, integer px.",
                    "type": "object",
                    "properties": {
                      "x": {
                        "type": "integer"
                      },
                      "y": {
                        "type": "integer"
                      }
                    },
                    "required": ["x", "y"],
                    "additionalProperties": false
                  },
                  "flipX": {
                    "description": "Mirror the bone horizontally about its pivot.",
                    "type": "boolean"
                  },
                  "interp": {
                    "description": "Interpolation from this key to the next: \"linear\" (default), \"step\", \"ease-in-out\".",
                    "type": "string",
                    "enum": ["step", "linear", "ease-in-out"]
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "parts": {
          "description": "Part keys by part-layer name (or part id); null removes the key.",
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "variant": {
                    "description": "Variant name or id, or \"auto\" (FR-RIG-14); holds until the next key.",
                    "type": "string",
                    "minLength": 1
                  },
                  "z": {
                    "description": "Draw order override; higher draws on top (default: the view's).",
                    "type": "integer"
                  },
                  "visible": {
                    "description": "Show or hide the part from this frame on.",
                    "type": "boolean"
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "required": ["doc", "animation", "frame"],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "animation": {
          "type": "string",
          "description": "\"group/direction\" of the posed animation."
        },
        "frameIndex": {
          "type": "integer"
        },
        "frameId": {
          "type": "string"
        },
        "changed": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Keys that changed, as \"bones.<name>\" / \"parts.<name>\"; empty when nothing did."
        }
      },
      "required": ["animation", "frameIndex", "frameId", "changed"],
      "additionalProperties": false
    },
    "annotations": {
      "title": "rig.setPose",
      "readOnlyHint": false,
      "destructiveHint": false,
      "openWorldHint": false
    },
    "_meta": {
      "pixel-forge/op": "rig.setPose",
      "pixel-forge/safety": "mutate"
    }
  }
]
