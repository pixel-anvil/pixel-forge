[
  {
    "name": "doc_open",
    "title": "doc.open",
    "description": "Open a .pxf file and return its document id, which every other op takes as \"doc\".\n\nOpening a file that is already open returns the same id (alreadyOpen: true) without re-reading it. Follow with doc_summary to see layers, rig and animations.\n\nReads or writes files through the host. Conventions: origin top-left, y down, angles in degrees clockwise, integer pixels.\n\nExample (Open the synthetic hero): {\"path\":\"/work/hero.pxf\"}",
    "inputSchema": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Path of the .pxf file (absolute, inside the workspace roots)."
        }
      },
      "required": ["path"],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "doc": {
          "type": "string",
          "pattern": "^doc_[0-9a-z]{1,24}$",
          "description": "Document id for the other ops."
        },
        "path": {
          "type": "string",
          "description": "Normalised path."
        },
        "name": {
          "type": "string",
          "description": "Document display name."
        },
        "alreadyOpen": {
          "type": "boolean",
          "description": "True when the file was open already."
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Problems found while reading (e.g. a dropped render cache)."
        }
      },
      "required": ["doc", "path", "name", "alreadyOpen", "warnings"],
      "additionalProperties": false
    },
    "annotations": {
      "title": "doc.open",
      "readOnlyHint": false,
      "destructiveHint": false,
      "openWorldHint": false
    },
    "_meta": {
      "pixel-forge/op": "doc.open",
      "pixel-forge/safety": "io"
    }
  },
  {
    "name": "doc_summary",
    "title": "doc.summary",
    "description": "Summarise an open document: canvas, palette, layers, rig (bones, parts, views) and animations.\n\nNames in the result (bones, parts, layers, animation group/direction) are what the other ops take as references.\n\nRead-only. Conventions: origin top-left, y down, angles in degrees clockwise, integer pixels.\n\nExample (Summarise the hero): {\"doc\":\"doc_g1ed5q\"}",
    "inputSchema": {
      "type": "object",
      "properties": {
        "doc": {
          "type": "string",
          "pattern": "^doc_[0-9a-z]{1,24}$",
          "description": "Document id returned by doc_open or doc_create, e.g. \"doc_g1ed5q\"."
        }
      },
      "required": ["doc"],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "doc": {
          "type": "string",
          "description": "Document id."
        },
        "name": {
          "type": "string"
        },
        "path": {
          "description": "Backing file, null for an unsaved document.",
          "type": ["string", "null"]
        },
        "version": {
          "type": "integer",
          "description": "Runtime version: +1 per change, undo and redo."
        },
        "dirty": {
          "type": "boolean",
          "description": "Changed (or undone/redone) since it was opened or last saved."
        },
        "canUndo": {
          "type": "boolean"
        },
        "canRedo": {
          "type": "boolean"
        },
        "canvas": {
          "type": "object",
          "properties": {
            "w": {
              "type": "integer"
            },
            "h": {
              "type": "integer"
            }
          },
          "required": ["w", "h"],
          "additionalProperties": false
        },
        "origin": {
          "type": "object",
          "properties": {
            "x": {
              "type": "integer"
            },
            "y": {
              "type": "integer"
            }
          },
          "required": ["x", "y"],
          "additionalProperties": false,
          "description": "Anchor pixel shared with the engine (mirroring flips about origin.x)."
        },
        "pixelsPerUnit": {
          "type": "number"
        },
        "colorMode": {
          "type": "string",
          "enum": ["rgba", "indexed"]
        },
        "paletteLocked": {
          "type": "boolean"
        },
        "palette": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "colors": {
                  "type": "integer"
                }
              },
              "required": ["name", "colors"],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ],
          "description": "The active palette, null when there is none."
        },
        "skins": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "layers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "path": {
                "type": "string",
                "description": "Names from the root, joined by \"/\"."
              },
              "kind": {
                "type": "string",
                "enum": ["pixel", "reference", "part", "group"]
              },
              "visible": {
                "type": "boolean"
              }
            },
            "required": ["id", "path", "kind", "visible"],
            "additionalProperties": false
          },
          "description": "Every layer, depth first, bottom to top."
        },
        "rig": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "bones": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      },
                      "parent": {
                        "type": ["string", "null"]
                      },
                      "length": {
                        "type": "integer"
                      }
                    },
                    "required": ["id", "name", "parent", "length"],
                    "additionalProperties": false
                  }
                },
                "parts": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string",
                        "description": "Part-layer name: how ops address the part."
                      },
                      "bone": {
                        "type": "string"
                      },
                      "variants": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    },
                    "required": ["id", "name", "bone", "variants"],
                    "additionalProperties": false
                  }
                },
                "views": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      },
                      "directions": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    },
                    "required": ["id", "name", "directions"],
                    "additionalProperties": false
                  }
                }
              },
              "required": ["bones", "parts", "views"],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ],
          "description": "Null when the document has no rig."
        },
        "animations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string",
                "description": "\"group/direction\", or \"group\" when undirected."
              },
              "group": {
                "type": "string"
              },
              "direction": {
                "type": ["string", "null"]
              },
              "loop": {
                "type": "string",
                "enum": ["loop", "once", "pingpong"]
              },
              "frames": {
                "type": "integer",
                "description": "Frame count (the source animation for a mirror)."
              },
              "durationMs": {
                "type": "integer",
                "description": "Total duration."
              },
              "mirrorOf": {
                "description": "Label of the source animation of a mirror.",
                "type": ["string", "null"]
              },
              "overrides": {
                "type": "integer"
              }
            },
            "required": [
              "id",
              "label",
              "group",
              "direction",
              "loop",
              "frames",
              "durationMs",
              "mirrorOf",
              "overrides"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "doc",
        "name",
        "path",
        "version",
        "dirty",
        "canUndo",
        "canRedo",
        "canvas",
        "origin",
        "pixelsPerUnit",
        "colorMode",
        "paletteLocked",
        "palette",
        "skins",
        "layers",
        "rig",
        "animations"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "title": "doc.summary",
      "readOnlyHint": true,
      "destructiveHint": false,
      "openWorldHint": false
    },
    "_meta": {
      "pixel-forge/op": "doc.summary",
      "pixel-forge/safety": "read"
    }
  },
  {
    "name": "rig_set_pose",
    "title": "rig.setPose",
    "description": "Set bone keys (angle deg clockwise, offset int px) and/or part keys (variant, z, visible) on one frame.\n\nKeys are sparse and merge: the channels you pass replace the stored ones, the others stay; null removes the whole key of that bone or part on this frame. Angles are relative to the rest pose and compose down the hierarchy. Mirror animations have no frames: pose their source. Check the result with render_frame and rig_joint_check.\n\nChanges the document as one undo step. Conventions: origin top-left, y down, angles in degrees clockwise, integer pixels.\n\nExample (Raise the right arm and bend the elbow on frame 0): {\"doc\":\"doc_g1ed5q\",\"animation\":{\"group\":\"default\"},\"frame\":0,\"bones\":{\"upper_arm_r\":{\"angle\":-45},\"lower_arm_r\":{\"angle\":-30}}}",
    "inputSchema": {
      "type": "object",
      "properties": {
        "doc": {
          "type": "string",
          "pattern": "^doc_[0-9a-z]{1,24}$",
          "description": "Document id returned by doc_open or doc_create, e.g. \"doc_g1ed5q\"."
        },
        "animation": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "group": {
                  "type": "string",
                  "pattern": "^[a-z0-9_-]{1,48}$"
                },
                "direction": {
                  "type": "string",
                  "pattern": "^[a-z0-9_-]{1,48}$"
                }
              },
              "required": ["group"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^anm_[0-9a-z]{1,24}$"
                }
              },
              "required": ["id"],
              "additionalProperties": false
            }
          ],
          "description": "Animation: {\"group\": \"run\", \"direction\": \"side\"} ({\"group\": \"idle\"} for an undirected one) or {\"id\": \"anm_...\"}."
        },
        "frame": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "string",
              "pattern": "^frm_[0-9a-z]{1,24}$"
            }
          ],
          "description": "Frame: 0-based index or frame id (\"frm_...\")."
        },
        "bones": {
          "description": "Bone keys by bone name (or id); null removes the key.",
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "angle": {
                    "description": "Rotation from the rest angle, degrees clockwise (child bones follow, FK).",
                    "type": "number"
                  },
                  "offset": {
                    "description": "Pivot translation from its rest position, integer px.",
                    "type": "object",
                    "properties": {
                      "x": {
                        "type": "integer"
                      },
                      "y": {
                        "type": "integer"
                      }
                    },
                    "required": ["x", "y"],
                    "additionalProperties": false
                  },
                  "flipX": {
                    "description": "Mirror the bone horizontally about its pivot.",
                    "type": "boolean"
                  },
                  "interp": {
                    "description": "Interpolation from this key to the next: \"linear\" (default), \"step\", \"ease-in-out\".",
                    "type": "string",
                    "enum": ["step", "linear", "ease-in-out"]
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "parts": {
          "description": "Part keys by part-layer name (or part id); null removes the key.",
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "variant": {
                    "description": "Variant name or id, or \"auto\" (FR-RIG-14); holds until the next key.",
                    "type": "string",
                    "minLength": 1
                  },
                  "z": {
                    "description": "Draw order override; higher draws on top (default: the view's).",
                    "type": "integer"
                  },
                  "visible": {
                    "description": "Show or hide the part from this frame on.",
                    "type": "boolean"
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "required": ["doc", "animation", "frame"],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "animation": {
          "type": "string",
          "description": "\"group/direction\" of the posed animation."
        },
        "frameIndex": {
          "type": "integer"
        },
        "frameId": {
          "type": "string"
        },
        "changed": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Keys that changed, as \"bones.<name>\" / \"parts.<name>\"; empty when nothing did."
        }
      },
      "required": ["animation", "frameIndex", "frameId", "changed"],
      "additionalProperties": false
    },
    "annotations": {
      "title": "rig.setPose",
      "readOnlyHint": false,
      "destructiveHint": false,
      "openWorldHint": false
    },
    "_meta": {
      "pixel-forge/op": "rig.setPose",
      "pixel-forge/safety": "mutate"
    }
  }
]
