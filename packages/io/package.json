{
  "name": "@pixel-forge/io",
  "version": "0.0.0",
  "description": ".pxf read/write and migrations, render cache, PNG/GIF/JPEG/WebP codecs, spritesheet JSON and .aseprite import. Takes a FileSystem port.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run --project io"
  },
  "dependencies": {
    "@pixel-forge/core": "workspace:*",
    "@pixel-forge/convert": "workspace:*",
    "@pixel-forge/png": "workspace:*"
  }
}
