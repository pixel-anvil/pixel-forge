; Engine configuration file for the pixel-forge Godot demo. Open or run it with Godot 4.6.
config_version=5

[application]

config/name="Pixel Forge Demo"
config/features=PackedStringArray("4.6")
run/main_scene="res://main.tscn"

[editor_plugins]

enabled=PackedStringArray("res://addons/pixel_forge/plugin.cfg")
