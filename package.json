{
  "name": "pixel-forge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Pixel-art editor/animator with pixel-aware rigs. Headless core shared by CLI, MCP server and editor.",
  "license": "MIT",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm depcruise && pnpm gen:check && pnpm license-check && pnpm privacy-check",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -b",
    "build": "tsc -b",
    "test": "vitest run --coverage",
    "depcruise": "depcruise packages --config .dependency-cruiser.cjs",
    "gen": "node scripts/gen.mjs",
    "gen:check": "node scripts/gen.mjs --check",
    "bench": "node scripts/placeholder.mjs bench",
    "fixtures": "tsc -b && node packages/testkit/bin/fixtures.mjs",
    "fixtures:check": "tsc -b && node packages/testkit/bin/fixtures.mjs --check",
    "golden:sheet": "tsc -b && node packages/testkit/bin/golden-sheet.mjs",
    "privacy-check": "sh scripts/privacy-check.sh --all",
    "license-check": "node scripts/license-check.mjs",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "dependency-cruiser": "^18.7.0",
    "eslint": "10.13.0",
    "license-checker-rseidelsohn": "^5.0.1",
    "prettier": "^3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
